# Community Skills Hub — Supabase Environment Configuration
# Duplicate this file as .env.local and replace the placeholder values with your Supabase project credentials.

# Your Supabase Project URL (e.g. https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Publishable / Anon Key (found in Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
